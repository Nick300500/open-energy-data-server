        {
          "datasource": {
            "type": "postgres",
            "uid": "PCOSEMA_TIMESCALEDB"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('1 hour', \"time\") AS \"time\",\n  AVG(\"Intensity [g/kWh]\") FILTER (WHERE type='consumption' AND state='$state') AS \"Consumption intensity $state\",\n  AVG(\"Intensity [g/kWh]\") FILTER (WHERE type='production' AND state='$state') AS \"Generation intensity $state\",\n  AVG(\"Intensity [g/kWh]\") FILTER (WHERE type='consumption' AND state='DE') AS \"Consumption intensity DE\",\n  AVG(\"Intensity [g/kWh]\") FILTER (WHERE type='production' AND state='DE') AS \"Generation intensity DE\"\nFROM cosema.co2_intensity\nWHERE mode='$mode' AND $__timeFilter(\"time\")\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Emissions intensity in $state",
      "type": "timeseries"
    },
