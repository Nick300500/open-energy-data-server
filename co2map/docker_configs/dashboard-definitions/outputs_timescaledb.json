      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PCOSEMA_TIMESCALEDB"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('1 hour', \"time\") AS \"time\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology IN ('Hydro Run-of-river and poundage','Hydro Water Reservoir')) AS \"Hydro\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology = 'Biomass') AS \"Biomass\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology = 'Nuclear') AS \"Nuclear\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology = 'Fossil Brown coal/Lignite') AS \"Lignite\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology = 'Fossil Hard coal') AS \"Hard coal\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology = 'Fossil Gas') AS \"Fossil gas\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology = 'Fossil Oil') AS \"Oil\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology IN ('Fossil Coal-derived gas','Fossil Oil shale','Waste','Other','Fossil Peat')) AS \"Other fossil\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology = 'Wind Onshore') AS \"Wind Onshore\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology = 'Wind Offshore') AS \"Wind Offshore\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology = 'Solar') AS \"Solar\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology IN ('Other renewable','Geothermal','Marine')) AS \"Other VRE\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology = 'Hydro Pumped Storage' AND \"Generation [MW]\" <= 0) AS \"Storage charge\",\n  SUM(\"Generation [MW]\") FILTER (WHERE technology = 'Hydro Pumped Storage' AND \"Generation [MW]\" > 0) AS \"Storage discharge\"\nFROM cosema.reg_generation\nWHERE state = '$state' AND mode = '$mode' AND balanced = '$balanced' AND $__timeFilter(\"time\")\nGROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Generation in $state",
      "type": "timeseries"
    },
