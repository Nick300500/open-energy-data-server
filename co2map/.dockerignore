# Secrets -- must never end up baked into an image layer.
keys.yaml
.env

__pycache__
*.pyc
.venv
logs
*.log

# Large local-only inputs (~13 GB, see UEBERGABE.md) -- not part of the repo,
# mounted as a volume on the server instead of being copied into the image.
inputs

.git

# Copied explicitly, early, alongside pyproject.toml (see Dockerfile) -- must
# stay out of the later `COPY . /app` or it clobbers the lock file `poetry
# install` just wrote with whatever's sitting in the build context.
poetry.lock
